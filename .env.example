# Firebase web config (task 3.1). Copy to `.env.local` and fill in from the
# Firebase console (Project settings > Your apps). With none of these set the
# app is purely local: no Publish/Feed buttons, no cloud calls.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Point everything at the local Auth/Firestore/Storage emulators instead
# (`npx firebase emulators:start`). Uses the demo-clumsyloop project and
# signs in anonymously; never touches real GCP.
# VITE_USE_FIREBASE_EMULATORS=true
