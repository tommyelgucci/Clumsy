// Firestore security rules. Task 3.2 originally scoped this to users/
// projects/entitlements only, on the reasoning that clips/reports (phases
// 4-5) weren't itemized tasks yet. They are now (4.1's schema half,
// 5.1) — added here for the same reason 3.2 itself was built ahead of
// its own nominal dependency (3.1, a real Firebase project + device):
// the RULES are fully testable against the local emulator with no
// client UI at all, even though the UI that would actually create these
// documents (the feed, a report button) is still pending, most of it
// gated on export (2.4) existing first, which is gated on the still-
// device-blocked camera plugin. See tasks.json's 4.1/5.1 verify_notes
// for exactly what this covers and what's still open.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // App-facing profile info (display name, avatar) — separate from the
    // Firebase Auth record itself. Publicly readable: the feed (phase 4)
    // needs to show a clip's owner without every viewer having their own
    // read of someone else's private data. Only the owning user can
    // write their own document, and only that document.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // A user's local stop-motion projects, synced to the cloud (the paid
    // "cloud save" feature — see RUMBO.md's Business model section).
    // Ownership is fixed at creation and never transferable: read/update/
    // delete all check the EXISTING document's ownerId (`resource.data`),
    // while create has to check the INCOMING one (`request.resource.data`)
    // since `resource` doesn't exist yet.
    match /projects/{projectId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
    }

    // Subscription entitlement (task 3.4/3.5). CLAUDE.md is explicit:
    // "Subscription entitlement is never trusted from the client — a
    // Cloud Function validates the receipt... and only then writes the
    // state to Firestore." Cloud Functions run with Admin SDK privileges,
    // which bypass these rules entirely — so the client-facing rule here
    // is allowed to be, and must be, this simple: read your own
    // entitlement to gate features locally, write none of it, ever,
    // your own document included.
    match /entitlements/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // A published clip (task 4.1's schema half). `hidden` is the
    // moderation flag task 5.2's Cloud Function sets once a clip crosses
    // the report threshold — Cloud Functions run with Admin SDK
    // privileges that bypass these rules entirely, so the client-facing
    // rule can and must refuse to ever let a client set it, matching how
    // `entitlements` above refuses all client writes for the same
    // "only a trusted server-side process decides this" reason.
    match /clips/{clipId} {
      // The feed only ever shows non-hidden clips to the public, but an
      // owner can still see their own even after it's hidden — so they
      // at least know it was taken down, rather than it silently
      // vanishing with no trace from their own perspective.
      allow read: if resource.data.hidden != true || (request.auth != null && request.auth.uid == resource.data.ownerId);
      // A client can only ever publish a clip as not-yet-hidden — hidden
      // is exclusively the moderation Cloud Function's to set.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId && request.resource.data.hidden == false;
      // No client update at all, not even the owner's — there's nothing
      // in v1 scope a client should be able to change about a published
      // clip (no caption editing, no un-hiding their own moderated
      // clip). The owner can still remove it entirely, though: a
      // genuine "take this down myself" action, same as `projects`.
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // A report against a clip (task 5.1). Deliberately write-only from
    // the client's side: reads only ever happen through the moderation
    // Cloud Function (task 5.2) and the internal review panel (task
    // 5.3), both trusted server-side/Admin-SDK paths that bypass these
    // rules entirely — a client has no legitimate reason to read anyone
    // else's reports, or even its own (there's no "my reports" screen in
    // v1 scope).
    match /reports/{reportId} {
      allow read: if false;
      // `reporterId` must match the caller, the same anti-spoofing check
      // `projects`' create rule already uses for `ownerId` — otherwise
      // one user could file a report that falsely attributes itself to
      // someone else.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reporterId;
      allow update, delete: if false;
    }
  }
}
